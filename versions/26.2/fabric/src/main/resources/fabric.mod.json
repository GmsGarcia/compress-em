{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],

  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}"
  },

  "license": "${license}",
  "icon": "assets/compress/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.gmsgarcia.compress.fabric.FabricCompressEm"
    ]
  },

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version} <26.3",
    "java": ">=${java_version}"
  }
}
